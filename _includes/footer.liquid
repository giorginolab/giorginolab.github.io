{% capture footer_contents %}
  &copy; Copyright {{ site.time | date: '%Y' }}
  {{ site.title }}. {{ site.footer_text }}
  {% if site.impressum_path %}
    <a href="{{ site.url }}{{ site.baseurl }}{{ site.impressum_path }}">Impressum</a>.
  {% endif %}
  {% if site.last_updated %}
    Last updated: {{ 'now' | date: '%B %d, %Y' }}.
  {% endif %}
{% endcapture %}

{% if site.footer_fixed %}
  <footer class="fixed-bottom" role="contentinfo">
    <div class="container mt-0">
      <div class="gl-footer-row">
        <a href="https://www.cnr.it" aria-label="Consiglio Nazionale delle Ricerche"><img src="{{ '/assets/img/cnr-logo.png' | relative_url }}" alt="CNR – Consiglio Nazionale delle Ricerche" height="35" /></a>
        <div class="gl-footer-text">{{ footer_contents }}</div>
        <a href="https://www.ibf.cnr.it" aria-label="CNR Istituto di Biofisica"><img src="{{ '/assets/img/cnr-ibf-logo.png' | relative_url }}" alt="CNR-IBF – Istituto di Biofisica" height="35" /></a>
      </div>
    </div>
  </footer>
{% else %}
  <footer class="sticky-bottom mt-5" role="contentinfo">
    {% if site.newsletter.enabled %}
      {% include newsletter.liquid %}
    {% endif %}

    <div class="container">
      <div class="gl-footer-row">
        <a href="https://www.cnr.it" aria-label="Consiglio Nazionale delle Ricerche"><img src="{{ '/assets/img/cnr-logo.png' | relative_url }}" alt="CNR – Consiglio Nazionale delle Ricerche" height="35" /></a>
        <div class="gl-footer-text">{{ footer_contents }}</div>
        <a href="https://www.ibf.cnr.it" aria-label="CNR Istituto di Biofisica"><img src="{{ '/assets/img/cnr-ibf-logo.png' | relative_url }}" alt="CNR-IBF – Istituto di Biofisica" height="35" /></a>
      </div>
    </div>
  </footer>
{% endif %}
