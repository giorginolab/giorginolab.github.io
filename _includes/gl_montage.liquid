{% comment %} Montage of figures from our papers, shown on the home page. Images in assets/img/montage/. {% endcomment %}
{% assign tile_sizes = '(max-width: 576px) calc(50vw - 20px), (max-width: 960px) calc(25vw - 14px), 226px' %}
{% assign wide_sizes = '(max-width: 576px) calc(100vw - 32px), (max-width: 960px) calc(50vw - 20px), 460px' %}
<div class="gl-montage">
  {%
    include figure.liquid path="assets/img/montage/scov2-ml188-unbinding.jpg" original_width=400 figure_class="tile" sizes=tile_sizes loading="eager"
    alt="Unbinding pathway of the ML188 inhibitor from the SARS-CoV-2 main protease" caption="Drug unbinding pathways"
  %}
  {%
    include figure.liquid path="assets/img/montage/mdcath-ss-melting.jpg" original_width=900 figure_class="tile" sizes=tile_sizes loading="eager"
    alt="Loss of secondary structure over time at 413 K and 450 K for mainly-alpha and mainly-beta CATH domains (mdCATH)" caption="mdCATH: thermal unfolding"
  %}
  {%
    include figure.liquid path="assets/img/montage/mdid-rmsd-id.jpg" original_width=700 figure_class="tile" sizes=tile_sizes loading="eager"
    alt="RMSD versus intrinsic dimension for folded and unfolded trajectories" caption="Intrinsic dimension of dynamics"
  %}
  {%
    include figure.liquid path="assets/img/montage/dtw-cost-matrix.jpg" original_width=800 figure_class="tile" sizes=tile_sizes loading="eager"
    alt="Dynamic time warping: cumulative cost matrix and optimal alignment path between two time series" caption="Dynamic time warping"
  %}
  {%
    include figure.liquid path="assets/img/montage/cg-protein-g.jpg" original_width=704 figure_class="wide" sizes=wide_sizes loading="lazy"
    alt="Folding pathways of protein G from machine-learned coarse-grained simulations" caption="Machine-learned coarse-grained models"
  %}
  {%
    include figure.liquid path="assets/img/montage/torchmd-fes.jpg" original_width=700 figure_class="wide" sizes=wide_sizes loading="lazy"
    alt="Free energy surfaces from all-atom and coarse-grained simulations" caption="Free energy landscapes"
  %}
</div>
<p class="gl-credits">
  Figures from our papers in <a href="https://doi.org/10.1093/nar/gkab977">NAR 2022</a> (CC BY-NC),
  <a href="https://doi.org/10.1038/s41597-024-04140-z">Sci Data 2024</a> (SI),
  <a href="https://doi.org/10.1038/s41467-023-41343-1">Nat Commun 2023</a> and <a href="https://doi.org/10.1021/acs.jctc.0c01343">JCTC 2021</a> (CC
  BY), cropped, and from the <a href="https://dynamictimewarping.github.io/">DTW</a> and
  <a href="https://www.giorginolab.it/MDIntrinsicDimension/">MDIntrinsicDimension</a> documentation.
</p>
